# ===================================================
# PHONE EDR & DEFENSE PLATFORM - .GITIGNORE
# Strict exclusion for all sensitive user data, photos,
# videos, databases, environment secrets, and credentials.
# ===================================================

# ---------------------------------------------------
# 1. Environment Variables & Secret Keys
# ---------------------------------------------------
.env
.env.*
!.env.example
*.key
*.pem
*.cert
*.crt
*.pfx
*.p12

# ---------------------------------------------------
# 2. Photos, Videos, Screen Proofs & User Uploads
# ---------------------------------------------------
uploads/
**/uploads/*
!**/uploads/**/.gitkeep
backend/uploads/*
!backend/uploads/**/.gitkeep

# Exclude raw & encrypted media file extensions
*.jpg
*.jpeg
*.png
*.gif
*.bmp
*.webp
*.mp4
*.webm
*.mkv
*.mov
*.avi
*.enc

# ---------------------------------------------------
# 3. Databases, State & Sensitive Runtime Data
# ---------------------------------------------------
data/
**/data/*
!**/data/**/.gitkeep
backend/data/*
!backend/data/**/.gitkeep
edr_database.json
*.db
*.sqlite
*.sqlite3

# ---------------------------------------------------
# 4. Logs, Crash Dumps & Live Telemetry
# ---------------------------------------------------
*.log
edr_device_telemetry.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
logs/
*.pid
*.seed

# ---------------------------------------------------
# 5. Node.js & Web Build Artifacts
# ---------------------------------------------------
node_modules/
**/node_modules/
dist/
**/dist/
build/
client-dist/
.npm
.cache/

# ---------------------------------------------------
# 6. Android & Gradle Build Artifacts & Credentials
# ---------------------------------------------------
.gradle/
**/build/
agent-android/build/
agent-android/app/build/
*.apk
*.ap_
*.aab
*.dex
*.class

# Android Local SDK configs and Signing Keys
local.properties
*.jks
*.keystore
signing.properties
google-services.json

# ---------------------------------------------------
# 7. IDE & Operating System Files
# ---------------------------------------------------
.idea/
*.iml
.vscode/
.DS_Store
Thumbs.db
desktop.ini
*.swp
*.swo
*~

