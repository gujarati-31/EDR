<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#0B0F19"
    android:fillViewport="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <!-- App Header -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:contentDescription="System App"
                android:src="@mipmap/ic_launcher" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="14dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Device Services"
                    android:textColor="#FFFFFF"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvVersion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="v3.3.0 • EDR Endpoint Protection"
                    android:textColor="#94A3B8"
                    android:textSize="11sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvConnectionStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="#064E3B"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="ACTIVE"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Protection Summary Banner -->
        <LinearLayout
            android:id="@+id/bannerScore"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:background="#1E293B"
            android:orientation="vertical"
            android:padding="16dp">

            <TextView
                android:id="@+id/tvProtectionScore"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Endpoint Security Status"
                android:textColor="#FFFFFF"
                android:textSize="14sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvProtectionSubtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="Evaluating required endpoint protections..."
                android:textColor="#94A3B8"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- All Granted Success Card (hidden if permissions missing) -->
        <LinearLayout
            android:id="@+id/cardAllGranted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:background="#064E3B"
            android:orientation="vertical"
            android:padding="18dp"
            android:visibility="gone">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="✓ All Protections Active"
                android:textColor="#A7F3D0"
                android:textSize="15sp"
                android:textStyle="bold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:text="All critical system permissions are turned on. Endpoint sensors are actively monitoring threats."
                android:textColor="#D1FAE5"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- Pending Permissions Section Header -->
        <TextView
            android:id="@+id/tvPendingHeader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="20dp"
            android:layout_marginBottom="8dp"
            android:text="REQUIRED PROTECTIONS (TAP TO TURN ON)"
            android:textColor="#38BDF8"
            android:textSize="11sp"
            android:textStyle="bold" />

        <!-- Dynamic Container for Pending Permissions -->
        <LinearLayout
            android:id="@+id/containerPendingPermissions"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />

        <!-- Completed / Granted Permissions Section (Hidden as per requirement) -->
        <LinearLayout
            android:id="@+id/sectionGranted"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="18dp"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/tvGrantedHeader"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:text="ACTIVE PROTECTIONS (TURNED ON)"
                android:textColor="#34D399"
                android:textSize="11sp"
                android:textStyle="bold" />

            <LinearLayout
                android:id="@+id/containerGrantedPermissions"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical" />
        </LinearLayout>

        <!-- Refresh Button -->
        <Button
            android:id="@+id/btnRefreshStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="24dp"
            android:backgroundTint="#2563EB"
            android:text="Refresh Protection Status"
            android:textColor="#FFFFFF"
            android:textSize="13sp" />

    </LinearLayout>
</ScrollView>
