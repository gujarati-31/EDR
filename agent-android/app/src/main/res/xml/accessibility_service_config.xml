<?xml version="1.0" encoding="utf-8"?>
<!--
  EDR Accessibility Service Configuration

  Event Types: Only listen to TYPE_WINDOW_STATE_CHANGED (foreground app changes)
  and TYPE_WINDOW_CONTENT_CHANGED for the MediaProjection dialog detection.
  DO NOT use typeAllMask — it fires on every UI interaction in every app and drains battery.

  canPerformGestures: false — the agent NEVER simulates touches or gestures in user apps.
  canRetrieveWindowContent: true — needed ONLY to find the "Start recording" button in the
    EDR MediaProjection grant dialog. This does NOT give us access to passwords or typed text.
  canTakeScreenshot: true — used for silent screen capture during trap app recording.

  notificationTimeout: 500ms — reduced from 100ms to avoid flooding the event bus.
-->
<accessibility-service xmlns:android="http://schemas.android.com/apk/res/android"
    android:accessibilityEventTypes="typeWindowStateChanged|typeWindowContentChanged"
    android:accessibilityFeedbackType="feedbackGeneric"
    android:accessibilityFlags="flagDefault|flagRetrieveInteractiveWindows"
    android:canRetrieveWindowContent="true"
    android:canPerformGestures="false"
    android:canTakeScreenshot="true"
    android:description="@string/accessibility_service_description"
    android:notificationTimeout="500" />
